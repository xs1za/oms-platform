        }
      }
    },
    "/internal/shifts/auto-close-unfilled": {
      "post": {
        "operationId": "oms5AutoCloseUnfilledShifts",
        "summary": "OMS5 auto close unfilled shifts after reporting period",
        "responses": {
          "200": { "description": "Auto close result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AutoCloseResult" } } } },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/timesheets": {
      "post": {
        "operationId": "oms5CreateTimesheet",
        "summary": "OMS5 create timesheet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TimesheetCreate" },
              "example": { "performer_id": "perf_123", "shift_id": "shf_123", "work_date": "2026-01-20", "hours": 8 }
            }
          }
        },
        "responses": {
          "200": { "description": "Timesheet created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Timesheet" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/operations/summary": {
      "get": {
        "operationId": "oms5OperationsSummary",
        "summary": "OMS5 operations summary",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Operations summary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationsSummary" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserLogin": {
        "type": "object",
        "required": ["username", "password"],
        "additionalProperties": false,
        "properties": {
          "username": { "type": "string", "minLength": 1 },
          "password": { "type": "string", "minLength": 1 }
        }
      },
      "ServiceLogin": {
        "type": "object",
        "required": ["client_id", "client_secret"],
        "additionalProperties": false,
        "properties": {
          "client_id": { "type": "string", "minLength": 1 },
          "client_secret": { "type": "string", "minLength": 1 }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": ["access_token", "token_type", "expires_at"],
        "properties": {
          "access_token": { "type": "string" },
          "token_type": { "type": "string", "const": "bearer" },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      },
      "TokenVerification": {
        "type": "object",
        "required": ["active", "subject", "type", "scopes"],
        "properties": {
          "active": { "type": "boolean" },
          "subject": { "type": "string" },
          "type": { "type": "string", "enum": ["user", "service"] },
          "scopes": { "type": "array", "items": { "type": "string" } }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": ["status", "service"],
        "properties": {
          "status": { "type": "string", "const": "ok" },
          "service": { "type": "string" }
        }
      },
      "LivenessResponse": {
        "type": "object",
        "required": ["status", "service", "checks"],
        "properties": {
          "status": { "type": "string", "const": "ok" },
          "service": { "type": "string" },
          "checks": { "type": "object", "additionalProperties": true }
        }
      },
      "ReadinessResponse": {
        "type": "object",
        "required": ["status", "service", "checks"],
        "properties": {
          "status": { "type": "string", "enum": ["ok", "failed"] },
          "service": { "type": "string" },
          "checks": { "type": "object", "additionalProperties": true }
        }
      },
      "EmployeeCreate": {
        "type": "object",
        "required": ["surname", "firstname", "gender"],
        "additionalProperties": false,
        "properties": {
          "surname": { "type": "string", "minLength": 1, "maxLength": 50 },
          "firstname": { "type": "string", "minLength": 1, "maxLength": 50 },
          "patronymic": { "type": "string", "maxLength": 50 },
          "personnel_number": { "type": "string", "maxLength": 250 },
          "gender": { "type": "string", "minLength": 1, "maxLength": 6 }
        }
      },
      "Employee": {
        "allOf": [
          { "$ref": "#/components/schemas/EmployeeCreate" },
          {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "integer" },
              "address": { "type": ["object", "null"] },
              "created_at": { "type": "string", "format": "date-time" },
              "updated_at": { "type": "string", "format": "date-time" }
            }
          }
        ]
      },
      "EmployeeList": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Employee" } }
        }
      },
      "ReportTaskCreate": {
        "type": "object",
        "required": ["reportType", "format"],
        "additionalProperties": false,
        "properties": {
          "reportType": { "type": "string", "minLength": 1 },
          "filter": { "type": "object" },
          "format": { "type": "string", "enum": ["xlsx", "csv", "pdf"] }
        }
      },
      "ReportTaskAccepted": {
        "type": "object",
        "required": ["taskId", "status", "statusUrl", "createdAt"],
        "properties": {
          "taskId": { "type": "string" },
          "status": { "type": "string", "const": "queued" },
          "statusUrl": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "ReportTask": {
        "type": "object",
        "required": ["taskId", "status", "progress", "createdAt", "updatedAt"],
        "properties": {
          "taskId": { "type": "string" },
          "status": { "type": "string", "enum": ["queued", "running", "completed", "failed", "cancelled", "expired"] },
          "progress": { "type": "number", "minimum": 0, "maximum": 100 },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "result": { "$ref": "#/components/schemas/ReportResult" },
          "error": { "$ref": "#/components/schemas/ReportError" }
        }
      },
      "ReportResult": {
        "type": ["object", "null"],
        "properties": {
          "fileName": { "type": "string" },
          "downloadUrl": { "type": "string" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "ReportError": {
        "type": ["object", "null"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "ReportDownload": {
        "type": "object",
        "required": ["downloadUrl", "expiresAt"],
        "properties": {
          "downloadUrl": { "type": "string", "format": "uri" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "EmailNotification": {
        "type": "object",
        "required": ["to", "subject", "body"],
        "additionalProperties": false,
        "properties": {
          "to": { "type": "string", "format": "email" },
          "subject": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 }
        }
      },
      "NotificationResult": {
        "type": "object",
        "required": ["notification_id", "channel", "to", "status", "created_at"],
        "properties": {
          "notification_id": { "type": "string" },
          "channel": { "type": "string", "const": "email" },
          "to": { "type": "string", "format": "email" },
          "status": { "type": "string", "enum": ["queued", "sent", "failed"] },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "ClientCreate": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "external_id": { "type": ["string", "null"] }
        }
      },
      "Client": {
        "allOf": [
          { "$ref": "#/components/schemas/ClientCreate" },
          { "type": "object", "required": ["id", "created_at"], "properties": { "id": { "type": "string" }, "created_at": { "type": "string", "format": "date-time" } } }
        ]
      },
      "ShiftCreate": {
        "type": "object",
        "required": ["client_id", "starts_at", "ends_at"],
        "additionalProperties": false,
        "properties": {
          "client_id": { "type": "string", "minLength": 1 },
          "starts_at": { "type": "string", "format": "date-time" },
          "ends_at": { "type": "string", "format": "date-time" },
          "location": { "type": ["string", "null"] },
          "required_performers_count": { "type": "integer", "minimum": 1, "maximum": 1, "default": 1 },
          "created_by_user_id": { "type": ["string", "null"] }
        }
      },
      "Shift": {
        "allOf": [
          { "$ref": "#/components/schemas/ShiftCreate" },
          {
            "type": "object",
            "required": ["id", "status", "created_at", "updated_at"],
            "properties": {
              "id": { "type": "string" },
              "status": { "$ref": "#/components/schemas/ShiftStatus" },
              "assigned_performer_id": { "type": ["string", "null"] },
              "close_reason": { "type": ["string", "null"], "enum": ["paid", "canceled", "failed", "deleted", null] },
              "failure_reason": { "type": ["string", "null"], "enum": ["absence", "no_performer_found", "client_rejected", "timesheet_invalid", "manual_admin_decision", null] },
              "auto_closed": { "type": "boolean" },
              "auto_close_reason": { "type": ["string", "null"] },
              "created_at": { "type": "string", "format": "date-time" },
              "updated_at": { "type": "string", "format": "date-time" }
            }
          }
        ]
      },
      "ShiftStatus": {
        "type": "string",
        "enum": ["A00_DRAFT", "A10_CONFIRM", "A20_SOURCING", "A30_CHOICE", "A40_EXECUTION", "A50_VERIFY", "A60_SETTLE", "A70_CONFIRM", "A80_CLOSED", "A90_ARCHIVE"]
      },
      "PerformerSync": {
        "type": "object",
        "required": ["employee_id", "display_name"],
        "additionalProperties": false,
        "properties": {
          "employee_id": { "type": "integer", "minimum": 1 },
          "display_name": { "type": "string", "minLength": 1 },
          "email": { "type": ["string", "null"], "format": "email" },
          "phone": { "type": ["string", "null"] },
          "status": { "type": "string", "default": "active" },
          "source_version": { "type": ["integer", "null"] }
        }
      },
      "Performer": {
        "allOf": [
          { "$ref": "#/components/schemas/PerformerSync" },
          { "type": "object", "required": ["id", "synced_at"], "properties": { "id": { "type": "string" }, "synced_at": { "type": "string", "format": "date-time" } } }
        ]
      },
      "ShiftTransition": {
        "type": "object",
        "required": ["new_status"],
        "additionalProperties": false,
        "properties": {
          "new_status": { "$ref": "#/components/schemas/ShiftStatus" },
          "reason": { "type": ["string", "null"] },
          "actor_user_id": { "type": ["string", "null"] },
          "close_reason": { "type": ["string", "null"], "enum": ["paid", "canceled", "failed", "deleted", null] },
          "failure_reason": { "type": ["string", "null"], "enum": ["absence", "no_performer_found", "client_rejected", "timesheet_invalid", "manual_admin_decision", null] }
        }
      },
      "ShiftStatusHistory": {
        "type": "object",
        "required": ["id", "shift_id", "from_status", "to_status", "transition_code", "occurred_at"],
        "properties": {
          "id": { "type": "string" },
          "shift_id": { "type": "string" },
          "from_status": { "$ref": "#/components/schemas/ShiftStatus" },
          "to_status": { "$ref": "#/components/schemas/ShiftStatus" },
          "transition_code": { "type": "string" },
          "reason": { "type": ["string", "null"] },
          "actor_user_id": { "type": ["string", "null"] },
          "occurred_at": { "type": "string", "format": "date-time" },
          "correlation_id": { "type": "string" },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      },
      "ShiftTransitionResult": {
        "type": "object",
        "required": ["shift", "history"],
        "properties": {
          "shift": { "$ref": "#/components/schemas/Shift" },
          "history": { "$ref": "#/components/schemas/ShiftStatusHistory" }
        }
      },
      "OfferCampaignCreate": {
        "type": "object",
        "required": ["performer_ids"],
        "additionalProperties": false,
        "properties": {
          "performer_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "created_by_user_id": { "type": ["string", "null"] }
        }
      },
      "ShiftOfferCampaign": {
        "type": "object",
        "required": ["id", "shift_id", "status", "created_at"],
        "properties": {
          "id": { "type": "string" },
          "shift_id": { "type": "string" },
          "status": { "type": "string", "enum": ["draft", "sent", "closed", "cancelled"] },
          "created_by_user_id": { "type": ["string", "null"] },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "ShiftOffer": {
        "type": "object",
        "required": ["id", "campaign_id", "shift_id", "performer_id", "status", "expires_at"],
        "properties": {
          "id": { "type": "string" },
          "campaign_id": { "type": "string" },
          "shift_id": { "type": "string" },
          "performer_id": { "type": "string" },
          "status": { "type": "string", "enum": ["draft", "sent", "viewed", "accepted", "declined", "won", "lost", "expired", "cancelled"] },
          "expires_at": { "type": "string", "format": "date-time" },
          "sent_at": { "type": "string", "format": "date-time" },
          "responded_at": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "OfferCampaignResult": {
        "type": "object",
        "required": ["campaign", "offers"],
        "properties": {
          "campaign": { "$ref": "#/components/schemas/ShiftOfferCampaign" },
          "offers": { "type": "array", "items": { "allOf": [{ "$ref": "#/components/schemas/ShiftOffer" }, { "type": "object", "properties": { "token": { "type": "string" }, "public_url": { "type": "string" } } }] } }
        }
      },
      "OfferAvailability": {
        "type": "object",
        "required": ["status", "offerStatus", "shiftStatus", "available"],
        "properties": {
          "status": { "type": "string" },
          "offerStatus": { "type": "string" },
          "shiftStatus": { "$ref": "#/components/schemas/ShiftStatus" },
          "available": { "type": "boolean" },
          "reason": { "type": ["string", "null"] }
        }
      },
      "PublicOffer": {
        "type": "object",
        "required": ["offer", "shift", "performer", "available"],
        "properties": {
          "offer": { "$ref": "#/components/schemas/ShiftOffer" },
          "shift": { "$ref": "#/components/schemas/Shift" },
          "performer": { "$ref": "#/components/schemas/Performer" },
          "available": { "type": "boolean" },
          "reason": { "type": ["string", "null"] }
        }
      },
      "ShiftAssignment": {
        "type": "object",
        "required": ["id", "shift_id", "performer_id", "offer_id", "status", "assigned_at"],
        "properties": {
          "id": { "type": "string" },
          "shift_id": { "type": "string" },
          "performer_id": { "type": "string" },
          "offer_id": { "type": "string" },
          "status": { "type": "string" },
          "assigned_at": { "type": "string", "format": "date-time" }
        }
      },
      "OfferAcceptResult": {
        "type": "object",
        "required": ["offer", "assignment", "shift"],
        "properties": {
          "offer": { "$ref": "#/components/schemas/ShiftOffer" },
          "assignment": { "$ref": "#/components/schemas/ShiftAssignment" },
          "shift": { "$ref": "#/components/schemas/Shift" }
        }
      },
      "TimesheetCreate": {
        "type": "object",
        "required": ["performer_id", "shift_id", "work_date", "hours"],
        "additionalProperties": false,
        "properties": {
          "performer_id": { "type": "string", "minLength": 1 },
          "shift_id": { "type": "string", "minLength": 1 },
          "work_date": { "type": "string", "format": "date" },
          "hours": { "type": "number", "exclusiveMinimum": 0, "maximum": 24 }
        }
      },
      "Timesheet": {
        "allOf": [
          { "$ref": "#/components/schemas/TimesheetCreate" },
          { "type": "object", "required": ["id", "created_at"], "properties": { "id": { "type": "string" }, "created_at": { "type": "string", "format": "date-time" } } }
        ]
      },
      "OperationsSummary": {
        "type": "object",
        "required": ["clients", "performers", "shifts", "offerCampaigns", "offers", "assignments", "timesheets"],
        "properties": {
          "clients": { "type": "integer", "minimum": 0 },
          "performers": { "type": "integer", "minimum": 0 },
          "shifts": { "type": "integer", "minimum": 0 },
          "offerCampaigns": { "type": "integer", "minimum": 0 },
          "offers": { "type": "integer", "minimum": 0 },
          "assignments": { "type": "integer", "minimum": 0 },
          "timesheets": { "type": "integer", "minimum": 0 }
        }
      },
      "AutoCloseResult": {
        "type": "object",
        "required": ["closed", "count"],
        "properties": {
          "closed": { "type": "array", "items": { "type": "string" } },
          "count": { "type": "integer", "minimum": 0 }
        }
      },
      "Error": {
        "type": "object",
        "required": ["detail"],
        "properties": { "detail": {} }
      }
    },
    "responses": {
      "BadRequest": { "description": "Bad request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unauthorized": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Conflict": { "description": "Conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Gone": { "description": "Gone", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "ValidationError": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "InternalServerError": { "description": "Internal server error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
