        "parameters": [
          { "name": "token", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } }
        ],
        "responses": {
          "200": { "description": "Offer accepted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OfferAcceptResult" } } } },
          "404": { "$ref": "#/components/responses/NotFound" },
